# Copy to .env and adjust for your Ollama host.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_PREDICT=512
OLLAMA_TIMEOUT_S=90
OLLAMA_RETRIES=2
OLLAMA_CONCURRENCY=2
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=4096
OLLAMA_JSON_SCHEMA=1
SENTIMENT_INTELLIGENCE_PROVIDER=ollama
SENTIMENT_INTELLIGENCE_MAX_TEXT_CHARS=4000
